\code{\link[=read_rate_workbook]{read_rate_workbook()}};
\item construct proposed tables with \code{\link[=replace_factor_set]{replace_factor_set()}}, \code{\link[=update_factors]{update_factors()}},
\code{\link[=rebase_factor_set]{rebase_factor_set()}}, and \code{\link[=normalize_factor_set]{normalize_factor_set()}};
\item review changes with \code{\link[=rate_plan_diff]{rate_plan_diff()}} and \code{\link[=validate_rate_plan]{validate_rate_plan()}};
\item compare rated outputs using \code{\link[=compare_rating_outputs]{compare_rating_outputs()}},
\code{\link[=summarize_rate_change]{summarize_rate_change()}}, and \code{\link[=rate_change_distribution]{rate_change_distribution()}}; and
\item solve a scalar rate-level adjustment with \code{\link[=solve_rate_target]{solve_rate_target()}}.
}
